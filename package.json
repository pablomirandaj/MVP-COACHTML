{
  "name": "football-coach-studio",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "packageManager": "pnpm@10.28.0",
  "scripts": {
    "catalog": "tsx packages/engine/scripts/build-catalog.ts && tsx packages/assistant/scripts/build-validator.ts",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "vitest run",
    "examples": "tsx packages/render/scripts/export-examples.ts",
    "db:migrate": "tsx packages/server/src/migrate-cli.ts",
    "server": "tsx packages/server/src/index.ts",
    "test:api": "TEST_DATABASE_URL=${TEST_DATABASE_URL:-postgres://postgres@127.0.0.1:55432/fcs_test} vitest run packages/server",
    "db:dev": "scripts/dev-db.sh",
    "web:dev": "pnpm --filter @fcs/web dev",
    "web:build": "pnpm --filter @fcs/web build",
    "e2e": "node packages/web/e2e/smoke.mjs",
    "studio:artifact": "pnpm --filter @fcs/web build:artifact",
    "e2e:studio": "node packages/web/e2e/studio-artifact.mjs"
  },
  "devDependencies": {
    "@types/node": "22.10.2",
    "tsx": "4.19.2",
    "typescript": "5.7.2",
    "vitest": "2.1.8",
    "yaml": "2.6.1"
  },
  "pnpm": {
    "onlyBuiltDependencies": [
      "esbuild"
    ]
  }
}
