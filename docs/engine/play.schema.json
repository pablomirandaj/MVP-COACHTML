{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://fcs.example/schemas/play/1",
  "title": "Football Coach Studio — PlayDoc (fcs.play/1)",
  "description": "Documento de jugada almacenado en tactical_play_version.document. Coordenadas normalizadas en marco de ataque (docs/14 §1).",
  "type": "object",
  "required": ["schema", "engine_version", "catalog_version", "type", "pitch", "actors", "movements"],
  "additionalProperties": false,
  "properties": {
    "schema": { "const": "fcs.play/1" },
    "engine_version": { "type": "string", "pattern": "^\\d+\\.\\d+\\.\\d+$" },
    "catalog_version": { "type": "string", "pattern": "^\\d+\\.\\d+\\.\\d+$" },
    "template": { "type": ["string", "null"] },
    "type": { "$ref": "https://fcs.example/schemas/command-ir/1.0#/$defs/playType" },
    "side": { "enum": ["LEFT", "RIGHT", "CENTER", null] },
    "pitch": {
      "type": "object", "required": ["length_m", "width_m"],
      "properties": { "length_m": { "type": "number", "minimum": 90, "maximum": 120 }, "width_m": { "type": "number", "minimum": 45, "maximum": 90 } }
    },
    "delivery": { "$ref": "#/$defs/delivery" },
    "actors": { "type": "array", "maxItems": 23, "items": { "$ref": "#/$defs/actor" } },
    "movements": { "type": "array", "items": { "$ref": "#/$defs/movement" } },
    "relations": { "type": "array", "items": { "$ref": "#/$defs/relation" } },
    "constraints": { "type": "array", "items": { "type": "object", "required": ["actor", "rule", "origin"], "properties": { "actor": { "type": "string" }, "rule": { "type": "string" }, "origin": { "$ref": "#/$defs/origin" } } } },
    "notes": { "type": "array", "items": { "type": "object", "required": ["id", "text", "origin"], "properties": { "id": { "type": "string" }, "text": { "type": "string", "maxLength": 1000 }, "origin": { "$ref": "#/$defs/origin" }, "anchor_actor": { "type": "string" } } } },
    "diagnostics": { "type": "array", "items": { "$ref": "#/$defs/diagnostic" } }
  },
  "$defs": {
    "pt": { "type": "object", "required": ["u", "v"], "additionalProperties": false, "properties": { "u": { "type": "number", "minimum": -0.04, "maximum": 1.04 }, "v": { "type": "number", "minimum": -0.04, "maximum": 1.04 } } },
    "origin": { "type": "string", "pattern": "^(EXPLICIT|TEAM_PREF|MANUAL|RULE:[A-Z0-9_-]+)$" },
    "provenance": { "type": "object", "additionalProperties": { "$ref": "#/$defs/origin" } },
    "actor": {
      "type": "object",
      "required": ["id", "team", "role", "start", "provenance"],
      "properties": {
        "id": { "type": "string" },
        "team": { "enum": ["OWN", "OPP"] },
        "player_id": { "type": ["string", "null"] },
        "label": { "type": "string", "maxLength": 4 },
        "role": { "$ref": "https://fcs.example/schemas/command-ir/1.0#/$defs/role" },
        "start": { "$ref": "#/$defs/pt" },
        "action_zone": { "$ref": "https://fcs.example/schemas/command-ir/1.0#/$defs/zone", "description": "Zona donde actúa el jugador (destino de remate o zona de espera). Usada por selectores como 'los dos del segundo palo'." },
        "group": { "type": "string" },
        "locked": { "type": "boolean", "default": false },
        "provenance": { "$ref": "#/$defs/provenance" }
      }
    },
    "movement": {
      "type": "object",
      "required": ["id", "actor", "type", "path", "t_start", "t_end", "provenance"],
      "properties": {
        "id": { "type": "string" },
        "actor": { "type": "string" },
        "type": { "$ref": "https://fcs.example/schemas/command-ir/1.0#/$defs/movement" },
        "path": { "type": "array", "minItems": 1, "items": { "$ref": "#/$defs/pt" } },
        "shape": { "enum": ["STRAIGHT", "CURVED_IN", "CURVED_OUT", "POLYLINE"] },
        "speed_mps": { "type": "number", "minimum": 0, "maximum": 9 },
        "anchor": { "type": "object", "properties": { "kind": { "enum": ["STARTS_AT", "ARRIVES_AT"] }, "event": { "enum": ["KICK", "BALL_ARRIVAL", "MOVEMENT_START", "MOVEMENT_END"] }, "ref": { "type": "string" }, "offset_s": { "type": "number" } } },
        "t_start": { "type": "number", "minimum": -2.5 },
        "t_end": { "type": "number" },
        "depends_on": { "type": "array", "items": { "type": "string" } },
        "provenance": { "$ref": "#/$defs/provenance" }
      }
    },
    "delivery": {
      "type": "object",
      "required": ["taker_actor", "swing", "trajectory", "target_point", "kick_t", "arrival_t", "provenance"],
      "properties": {
        "taker_actor": { "type": "string" },
        "ball_start": { "$ref": "#/$defs/pt" },
        "swing": { "enum": ["INSWING", "OUTSWING", "NONE"] },
        "trajectory": { "enum": ["DRIVEN", "LOFTED", "LOW", "SHORT"] },
        "technique": { "enum": ["INSIDE_FOOT", "OUTSIDE_FOOT", "INSTEP"] },
        "target_zone": { "$ref": "https://fcs.example/schemas/command-ir/1.0#/$defs/zone" },
        "target_point": { "$ref": "#/$defs/pt" },
        "curve": { "type": "number", "minimum": 0, "maximum": 0.35 },
        "kick_t": { "const": 0 },
        "arrival_t": { "type": "number", "exclusiveMinimum": 0 },
        "provenance": { "$ref": "#/$defs/provenance" }
      }
    },
    "relation": {
      "type": "object",
      "required": ["type"],
      "properties": {
        "type": { "enum": ["SCREENS", "CROSSES_WITH", "MARKS"] },
        "blocker": { "type": "string" }, "defender": { "type": "string" }, "beneficiary": { "type": "string" },
        "a": { "type": "string" }, "b": { "type": "string" },
        "strict_legal": { "type": "boolean" },
        "origin": { "$ref": "#/$defs/origin" }
      }
    },
    "diagnostic": {
      "type": "object",
      "required": ["rule_id", "severity", "message"],
      "properties": {
        "rule_id": { "type": "string" },
        "class": { "enum": ["LAW", "GEOMETRY", "ROSTER", "TECHNIQUE", "TACTICAL", "SEQUENCE", "LINEUP"] },
        "severity": { "enum": ["error", "warning", "info", "clarification"] },
        "message": { "type": "string" },
        "actors": { "type": "array", "items": { "type": "string" } },
        "suggestion": { "type": "array", "items": { "type": "object" } }
      }
    }
  }
}
